NAS_CLOUD_STORAGE_ROOT=/mnt/nas-cloud
NAS_CLOUD_DB_PATH=/data/nas-cloud.sqlite
NAS_CLOUD_PUBLIC_BASE_PATH=/files
NAS_CLOUD_MAX_UPLOAD_BYTES=2147483648
# Run the in-process preview scheduler so previews are produced without a cron.
# Set to "off" if you'd rather drive POST /api/maintenance/previews from cron.
NAS_CLOUD_PREVIEW_SCHEDULER=on
# Set "true" ONLY when the app is served over HTTPS/TLS (e.g. behind a reverse
# proxy). Over plain HTTP it marks cookies Secure, which browsers drop, blocking
# login. Leave unset/false for direct LAN access over http://<nas-ip>:3000.
# NAS_CLOUD_SECURE_COOKIES=false
