NAS_CLOUD_STORAGE_ROOT=.data/storage
NAS_CLOUD_DB_PATH=.data/nas-cloud.sqlite
NAS_CLOUD_PUBLIC_BASE_PATH=/files
NAS_CLOUD_MAX_UPLOAD_BYTES=2147483648
# Set to "on" to run the in-process preview scheduler. Defaults to off so dev
# environments don't fight the test runner; production deployments should
# either set this on, or hit POST /api/maintenance/previews from cron.
NAS_CLOUD_PREVIEW_SCHEDULER=off
# Set "true" ONLY when the app is served over HTTPS/TLS. Over plain HTTP it marks
# cookies Secure, which browsers drop, blocking login. Defaults to false.
# NAS_CLOUD_SECURE_COOKIES=false
